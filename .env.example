# ---------------------------------------------------------------------------
# Model backends. Defaults are the Claude stack (the calibration baseline).
#   EVAL_PROVIDER: anthropic | workers-ai     (who judges answers)
#   OCR_PROVIDER:  claude    | google-vision  (who reads the pages)
# The free stack is EVAL_PROVIDER=workers-ai + OCR_PROVIDER=google-vision.
# ---------------------------------------------------------------------------
EVAL_PROVIDER=anthropic
OCR_PROVIDER=claude

# Anthropic (EVAL_PROVIDER=anthropic) - https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...
# Model used for OCR + evaluation (optional, defaults to claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5

# Cloudflare Workers AI (EVAL_PROVIDER=workers-ai) - free tier: 10k neurons/day
# https://developers.cloudflare.com/workers-ai/
#CF_ACCOUNT_ID=...
#CF_API_TOKEN=...
#WORKERS_AI_EVAL_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#WORKERS_AI_SEGMENT_MODEL=@cf/meta/llama-3.1-8b-instruct

# Google Cloud Vision (OCR_PROVIDER=google-vision) - free tier: 1000 pages/month
# https://cloud.google.com/vision/docs/setup
#GOOGLE_VISION_API_KEY=...

# Where jobs, uploads and results are stored (optional, defaults to ./data)
DATA_DIR=data

# --- Public-exposure guardrails (0 disables a check) -----------------------
# Throttles per client address, a global daily cap (the budget kill-switch),
# bounded pipeline concurrency, and data retention for uploaded sheets.
#SUBMISSIONS_PER_HOUR_PER_IP=6
#CONTRIBUTIONS_PER_HOUR_PER_IP=10
#GLOBAL_JOBS_PER_DAY=300
#MAX_CONCURRENT_JOBS=2
#RETENTION_DAYS=30

# --- PDF rasterization -----------------------------------------------------
# PDFs are rendered to page images at upload; one upload may expand to at
# most MAX_PDF_PAGES pages.
#RASTER_DPI=200
#MAX_PDF_PAGES=40
